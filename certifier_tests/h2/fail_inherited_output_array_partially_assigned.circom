pragma circom 2.2.0;

// (H2 inherited tags + structural) FAIL: o[0] gets an honest inherited
// {binary}, but o[1] is never assigned. Inheritance itself does not check
// that every position gets a value; the structural analysis (the one
// --inspect runs, always on under -cbc) does: CA01 on an output is
// promoted. Guarantee: an accepted circuit never has an output position
// without a value.
// @expect FAIL
// @certified 0
// @trusted IsZero()
// @fail Top() CA01
// @circomlib IsZero

template Top() {
    signal input a;
    signal output {binary} o[2];
    signal t;
    t <== IsZero()(a);
    o[0] <== t;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ===== END circomlib =====

component main = Top();
