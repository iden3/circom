pragma circom 2.2.0;

// (H1 + H2, inherited tags) FAIL: `t <-- z` carries no tags (circom only
// propagates through `<==`): CE01 on t, CE02 on o.
// @expect FAIL
// @certified 0
// @trusted IsZero()
// @fail Top() CE01 CE02
// @circomlib IsZero

template Top() {
    signal input a;
    signal output {binary} o;
    signal z <== IsZero()(a);
    signal t;
    t <-- z;
    t === z;
    o <== t;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ===== END circomlib =====

component main = Top();
