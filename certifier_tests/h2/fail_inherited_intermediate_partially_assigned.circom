pragma circom 2.2.0;

// (H2 inherited tags) FAIL, same rule as circom: t[1] is never assigned, so
// `t` is not complete, and circom only propagates inherited tags out of a
// complete signal (`remaining_inserts == 0`). -cbc checks completeness on
// the instance's constraints (every `<==` mentions its position): t
// inherits nothing, so o's {binary} has no honest source -> CE02.
// @expect FAIL
// @certified 0
// @trusted IsZero()
// @fail Top() CE02
// @circomlib IsZero

template Top() {
    signal input a;
    signal output {binary} o;
    signal t[2];
    t[0] <== IsZero()(a);
    o <== t[0];
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ===== END circomlib =====

component main = Top();
