pragma circom 2.2.0;

// (H2) FAIL, regression test for a closed soundness hole: `m.maxbit = 4` is
// set by hand and m is then copied (bare, by name honest) from Bits2Num(8)
// outputs whose real bound is 8 bits. circom keeps the hand-set 4 and
// ignores the source's 8, so LessThan(4) would compare 8-bit values: unsound.
// A tag value typed in is never honest: CE02 at the assignment.
// @expect FAIL
// @certified 0
// @trusted Num2Bits(8)
// @trusted Bits2Num(8,null)
// @trusted Num2Bits(5)
// @trusted LessThan(4,4)
// @fail Top() CE02
// @circomlib Num2Bits Bits2Num LessThan

template Top() {
    signal input a;
    signal input b;
    signal output o;
    signal {maxbit} m[2];
    m.maxbit = 4;
    m[0] <== Bits2Num(8)(Num2Bits(8)(a));
    m[1] <== Bits2Num(8)(Num2Bits(8)(b));
    o <== LessThan(4)(m);
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/bitify.circom

function maxbits(){
    var n = 1;
    var r = 1;
    while(2 * n > n){
        n = n * 2;
        r = r + 1;
    }
    return r + 1;
}

template Num2Bits(n) {
    input signal in;
    output signal {binary} out[n];
    var lc1=0;

    var e2=1;
    for (var i = 0; i<n; i++) {
        out[i] <-- (in >> i) & 1;
        out[i] * (out[i] -1 ) === 0;
        lc1 += out[i] * e2;
        e2 = e2+e2;
    }
    
    lc1 === in;
}

template Bits2Num(n) {
    input signal {binary} in[n];
    output signal {maxbit} out;
    var lc1=0;

    var e2 = 1;
    for (var i = 0; i<n; i++) {
        lc1 += in[i] * e2;
        e2 = e2 + e2;
    }
    out.maxbit = n;
    lc1 ==> out;
}

// ---- circuits/comparators.circom

template LessThan(n) {
    assert(n <= maxbits()-2);
    input signal {maxbit} in[2];
    output signal {binary} out;
    
    assert(in.maxbit <= n);

    component n2b = Num2Bits(n+1);

    n2b.in <== in[0]+ (1<<n) - in[1];

    out <== 1-n2b.out[n];
}

// ===== END circomlib =====

component main = Top();
