pragma circom 2.2.0;

// (H2 + H3) FAIL: MyBits2Num is a token-for-token copy of circomlib's
// Bits2Num, only renamed. Trust is keyed by (name, hash), so the copy is
// NOT trusted and is checked like any own code: `out.maxbit = n;
// lc1 ==> out;` is a bare {maxbit} tag -> CE02. The genuine Num2Bits that
// feeds it stays trusted.
// @expect FAIL
// @certified 1
// @trusted Num2Bits(4)
// @fail MyBits2Num(4,null) CE02
// @circomlib Num2Bits

template MyBits2Num(n) {
    input signal {binary} in[n];
    output signal {maxbit} out;
    var lc1=0;

    var e2 = 1;
    for (var i = 0; i<n; i++) {
        lc1 += in[i] * e2;
        e2 = e2 + e2;
    }
    out.maxbit = n;
    lc1 ==> out;
}

template Top() {
    signal input a;
    signal output out;
    component n2b = Num2Bits(4);
    n2b.in <== a;
    component b2n = MyBits2Num(4);
    b2n.in <== n2b.out;
    out <== b2n.out;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/bitify.circom

template Num2Bits(n) {
    input signal in;
    output signal {binary} out[n];
    var lc1=0;

    var e2=1;
    for (var i = 0; i<n; i++) {
        out[i] <-- (in >> i) & 1;
        out[i] * (out[i] -1 ) === 0;
        lc1 += out[i] * e2;
        e2 = e2+e2;
    }
    
    lc1 === in;
}

// ===== END circomlib =====

component main = Top();
