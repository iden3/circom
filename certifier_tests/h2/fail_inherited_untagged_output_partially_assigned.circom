pragma circom 2.2.0;

// (H2 inherited tags + structural) FAIL twice over: the inheritance SOURCE
// `raw` is an output array whose position raw[1] is never assigned. So
// `raw` is incomplete and inherits nothing (CE02 on o, as in circom), and
// raw[1] is an output with no value (CA01, promoted and flagged as not
// safe).
// @expect FAIL
// @certified 0
// @trusted IsZero()
// @fail Top() CA01 CE02
// @circomlib IsZero

template Top() {
    signal input a;
    signal output raw[2];
    signal output {binary} o;
    raw[0] <== IsZero()(a);
    o <== raw[0];
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ===== END circomlib =====

component main = Top();
