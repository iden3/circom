pragma circom 2.2.0;

// (H2) FAIL, agreeing with circom: Mid's output `t` declares no tag, so the
// {binary} of IsZero does not cross Mid's boundary (circom itself rejects
// feeding `Mid()(a)` into a {binary} input, T3001). Top's {binary} output
// copied from it is a bare tag: CE02.
// @expect FAIL
// @certified 1
// @trusted IsZero()
// @fail Top() CE02
// @circomlib IsZero

template Mid() {
    signal input a;
    signal output t;
    t <== IsZero()(a);
}

template Top() {
    signal input a;
    signal output {binary} o;
    o <== Mid()(a);
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ===== END circomlib =====

component main = Top();
