pragma circom 2.2.0;

// (H2) PASS: a tagged INPUT array copied whole to a tagged output array.
// @expect PASS
// @certified 2
// @trusted Num2Bits(4)
// @circomlib Num2Bits

template Relay(n) {
    signal input {binary} in[n];
    signal output {binary} out[n];
    out <== in;
}

template Top() {
    signal input a;
    signal output {binary} out[4];
    out <== Relay(4)(Num2Bits(4)(a));
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/bitify.circom

template Num2Bits(n) {
    input signal in;
    output signal {binary} out[n];
    var lc1=0;

    var e2=1;
    for (var i = 0; i<n; i++) {
        out[i] <-- (in >> i) & 1;
        out[i] * (out[i] -1 ) === 0;
        lc1 += out[i] * e2;
        e2 = e2+e2;
    }
    
    lc1 === in;
}

// ===== END circomlib =====

component main = Top();
