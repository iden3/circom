pragma circom 2.2.0;

// (H2) FAIL: t2 breaks the chain (`t1 * 1` is an expression). t2 gets CE02,
// and so does `out`, whose source t2 is not a legitimate tag source.
// @expect FAIL
// @certified 0
// @trusted IsZero()
// @fail T() CE02 CE02
// @circomlib IsZero

template T() {
    signal input a;
    signal output {binary} out;
    signal {binary} t1;
    signal {binary} t2;
    t1 <== IsZero()(a);
    t2 <== t1 * 1;
    out <== t2;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ===== END circomlib =====

component main = T();
