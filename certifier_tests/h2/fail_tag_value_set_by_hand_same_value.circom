pragma circom 2.2.0;

// (H2) FAIL: same as fail_tag_value_set_by_hand_lie.circom but the hand-set
// value (8) happens to be right. It is still an unchecked claim (-cbc does
// not compare values): a hand-set tag value is never correct by
// construction, whatever it is.
// @expect FAIL
// @certified 0
// @trusted Num2Bits(8)
// @trusted Bits2Num(8,null)
// @fail Top() CE02
// @circomlib Num2Bits Bits2Num

template Top() {
    signal input a;
    signal output {maxbit} o;
    o.maxbit = 8;
    o <== Bits2Num(8)(Num2Bits(8)(a));
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/bitify.circom

template Num2Bits(n) {
    input signal in;
    output signal {binary} out[n];
    var lc1=0;

    var e2=1;
    for (var i = 0; i<n; i++) {
        out[i] <-- (in >> i) & 1;
        out[i] * (out[i] -1 ) === 0;
        lc1 += out[i] * e2;
        e2 = e2+e2;
    }
    
    lc1 === in;
}

template Bits2Num(n) {
    input signal {binary} in[n];
    output signal {maxbit} out;
    var lc1=0;

    var e2 = 1;
    for (var i = 0; i<n; i++) {
        lc1 += in[i] * e2;
        e2 = e2 + e2;
    }
    out.maxbit = n;
    lc1 ==> out;
}

// ===== END circomlib =====

component main = Top();
