pragma circom 2.2.0;

// (H2, inherited tags) PASS: `t[1] <== t[0]` refers to the same collapsed
// path. Resolved as a greatest fixpoint: t inherits what its other
// assignment brings ({binary}), not nothing.
// @expect PASS
// @certified 1
// @trusted IsZero()
// @circomlib IsZero

template Top() {
    signal input a;
    signal output {binary} o;
    signal t[2];
    t[0] <== IsZero()(a);
    t[1] <== t[0];
    o <== t[1];
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ===== END circomlib =====

component main = Top();
