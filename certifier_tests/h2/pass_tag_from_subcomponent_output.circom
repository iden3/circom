pragma circom 2.2.0;

// (H2) PASS, two levels: Middle copies the TAGGED output of its
// subcomponent Relay into its own tagged output. A caller trusts the
// callee's declared output tag; the callee itself is checked separately
// (Relay certifies on its own).
// @expect PASS
// @certified 3
// @trusted IsZero()
// @circomlib IsZero

template Relay() {
    signal input {binary} in;
    signal output {binary} out;
    out <== in;
}

template Middle() {
    signal input {binary} a;
    signal output {binary} out;
    component r = Relay();
    r.in <== a;
    out <== r.out;
}

template Top() {
    signal input a;
    signal output {binary} out;
    out <== Middle()(IsZero()(a));
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ===== END circomlib =====

component main = Top();
