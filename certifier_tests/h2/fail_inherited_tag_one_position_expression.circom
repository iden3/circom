pragma circom 2.2.0;

// (H2, inherited tags) FAIL: t[1] comes from an expression, so t inherits
// nothing (intersection over all positions, as in circom), even though the
// position actually read, t[0], was an honest copy. The claim is checked
// against the FINAL intersection, so the later assignment counts.
// @expect FAIL
// @certified 0
// @trusted IsZero()
// @fail Top() CE02
// @circomlib IsZero

template Top() {
    signal input a;
    signal output {binary} o;
    signal t[2];
    t[0] <== IsZero()(a);
    o <== t[0];
    t[1] <== a * a;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ===== END circomlib =====

component main = Top();
