pragma circom 2.2.0;

// (H2 + H3) FAIL: three elements copied honestly from Num2Bits, the last
// one from an expression. Like circom's own tag propagation, one dishonest
// position disqualifies the whole array: one CE02.
// @expect FAIL
// @certified 0
// @trusted Num2Bits(4)
// @fail Top() CE02
// @circomlib Num2Bits

template Top() {
    signal input a;
    signal output {binary} bits[4];
    component n2b = Num2Bits(4);
    n2b.in <== a;
    for (var i = 0; i < 3; i++) {
        bits[i] <== n2b.out[i];
    }
    bits[3] <== 1 - n2b.out[3];
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/bitify.circom

template Num2Bits(n) {
    input signal in;
    output signal {binary} out[n];
    var lc1=0;

    var e2=1;
    for (var i = 0; i<n; i++) {
        out[i] <-- (in >> i) & 1;
        out[i] * (out[i] -1 ) === 0;
        lc1 += out[i] * e2;
        e2 = e2+e2;
    }
    
    lc1 === in;
}

// ===== END circomlib =====

component main = Top();
