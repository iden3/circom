pragma circom 2.2.0;

// (H2) FAIL: the source carries {binary}, the destination claims {tagB}.
// @expect FAIL
// @certified 0
// @trusted IsZero()
// @fail Top() CE02
// @circomlib IsZero

template Top() {
    signal input a;
    signal output {tagB} out;
    out <== IsZero()(a);
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ===== END circomlib =====

component main = Top();
