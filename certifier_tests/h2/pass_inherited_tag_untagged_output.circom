pragma circom 2.2.0;

// (H2, inherited tags) PASS: an OUTPUT declared without tags also inherits
// inside its own template, so a sibling tagged output can be copied from
// it. (It is not exported: callers only see declared port tags, see
// fail_untagged_output_does_not_inherit.circom.)
// @expect PASS
// @certified 1
// @trusted IsZero()
// @circomlib IsZero

template Top() {
    signal input a;
    signal output raw;
    signal output {binary} o;
    raw <== IsZero()(a);
    o <== raw;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ===== END circomlib =====

component main = Top();
