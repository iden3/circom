pragma circom 2.2.0;

// (H2 inherited tags) PASS, documents the "tags compared by name" decision:
// t[0] inherits {maxbit} with value 4, t[1] with value 8. circom drops the
// tag on a value mismatch; -cbc (which never tracks tag values, also not
// for declared tags) keeps the NAME. Consequence: o's {maxbit} ends up with
// NO value in circom, so any consumer reading o.maxbit is stopped by circom
// itself (see compile_errors/inherited_maxbit_value_lost_then_read).
// @expect PASS
// @certified 1
// @trusted Bits2Num(4,null)
// @trusted Bits2Num(8,null)
// @trusted Num2Bits(4)
// @trusted Num2Bits(8)
// @circomlib Num2Bits Bits2Num

template Top() {
    signal input a;
    signal input b;
    signal output {maxbit} o;
    signal t[2];
    t[0] <== Bits2Num(4)(Num2Bits(4)(a));
    t[1] <== Bits2Num(8)(Num2Bits(8)(b));
    o <== t[0];
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/bitify.circom

template Num2Bits(n) {
    input signal in;
    output signal {binary} out[n];
    var lc1=0;

    var e2=1;
    for (var i = 0; i<n; i++) {
        out[i] <-- (in >> i) & 1;
        out[i] * (out[i] -1 ) === 0;
        lc1 += out[i] * e2;
        e2 = e2+e2;
    }
    
    lc1 === in;
}

template Bits2Num(n) {
    input signal {binary} in[n];
    output signal {maxbit} out;
    var lc1=0;

    var e2 = 1;
    for (var i = 0; i<n; i++) {
        lc1 += in[i] * e2;
        e2 = e2 + e2;
    }
    out.maxbit = n;
    lc1 ==> out;
}

// ===== END circomlib =====

component main = Top();
