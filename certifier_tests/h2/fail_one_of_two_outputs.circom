pragma circom 2.2.0;

// (H2) FAIL: two tagged outputs, only the second one is bare (`1 - a` is
// the binary NOT, but it is an expression). Exactly one CE02.
// @expect FAIL
// @certified 1
// @trusted IsZero()
// @fail Two(null) CE02
// @circomlib IsZero

template Two() {
    signal input {binary} a;
    signal output {binary} good;
    signal output {binary} bad;
    good <== a;
    bad <== 1 - a;
}

template Top() {
    signal input x;
    signal output {binary} o1;
    signal output {binary} o2;
    (o1, o2) <== Two()(IsZero()(x));
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ===== END circomlib =====

component main = Top();
