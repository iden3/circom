pragma circom 2.2.0;

// (H2) PASS: the source carries {minvalue, maxvalue}; the destination only
// claims {maxvalue}. A superset source is enough.
// @expect PASS
// @certified 1
// @trusted MinMaxValueCheck(10,20)
// @trusted Num2Bits(5)
// @trusted CompConstant(5,9,null)
// @trusted CompConstant(5,20,null)
// @trusted AND(null,null)
// @trusted OR(null,null)
// @circomlib MinMaxValueCheck

template Top() {
    signal input a;
    signal output {maxvalue} out;
    signal {minvalue, maxvalue} r <== MinMaxValueCheck(10, 20)(a);
    out <== r;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/bitify.circom

function maxbits(){
    var n = 1;
    var r = 1;
    while(2 * n > n){
        n = n * 2;
        r = r + 1;
    }
    return r + 1;
}

function nbits(a) {
    if (a == 0){
       return 1;
    } else if (a < 0){ // in case a > p \ 2 -> we need maxbits()
       return(maxbits()); 
    } else{
        var n = 1;
        var r = 0;
    
        while (n-1<a && n >= 0) {
            r++;
            n *= 2;
        }
        if (n-1 < 0){
            return maxbits();
        }
        return r;
    }
}

template Num2Bits(n) {
    input signal in;
    output signal {binary} out[n];
    var lc1=0;

    var e2=1;
    for (var i = 0; i<n; i++) {
        out[i] <-- (in >> i) & 1;
        out[i] * (out[i] -1 ) === 0;
        lc1 += out[i] * e2;
        e2 = e2+e2;
    }
    
    lc1 === in;
}

// ---- circuits/comparators.circom

template CompConstant(n,ct) {
    assert(nbits(ct) <= n);
    input signal {binary} in[n];
    output signal {binary} out;

    signal {binary} res[n];
    if (ct & 1 == 0) {
        res[0] <== in[0];
    } else {
        res[0] <== 0;
    }
    for (var i=1; i < n; i++) {
        // re[i-1] says if in[0..i-1] > ct[0..i-1] (upto bit i-1)
        if ((ct >> i) & 1 == 0) {
            res[i] <== OR()(res[i-1],in[i]);
        } else {
            res[i] <== AND()(res[i-1],in[i]);
	}
    }
    out <== res[n-1];
}

// ---- circuits/gates.circom

template AND() {
    input signal {binary} a;
    input signal {binary} b;
    output signal {binary} out;

    out <== a*b;
}

template OR() {
    input signal {binary} a;
    input signal {binary} b;
    output signal {binary} out;

    out <== a + b - a*b;
}

// ---- circuits/tags-managing.circom

template MinMaxValueCheck(ct1,ct2){
    assert(ct1 >= 1);
    input signal in;
    output signal {minvalue,maxvalue} out;

    var n = nbits(ct2);
    signal inb[n] <== Num2Bits(n)(in);
    signal res1 <== CompConstant(n, ct1-1)(inb);
    res1 === 1;
    out.minvalue = ct1;
    signal res2 <== CompConstant(n, ct2)(inb);
    res2 === 0;    
    out.maxvalue = ct2;
    out <== in;
}

// ===== END circomlib =====

component main = Top();
