pragma circom 2.2.0;

// (H2) PASS: Relay's tagged output is a bare copy of an input that carries
// the same tag. Input tags are assumptions inside Relay (the caller must
// establish them, and circom checks that at every call site). The main
// component cannot have tagged inputs, so Top manufactures the tag with the
// trusted circomlib IsZero.
// @expect PASS
// @certified 2
// @trusted IsZero()
// @circomlib IsZero

template Relay() {
    signal input {binary} in;
    signal output {binary} out;
    out <== in;
}

template Top() {
    signal input a;
    signal output {binary} out;
    component r = Relay();
    r.in <== IsZero()(a);
    out <== r.out;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ===== END circomlib =====

component main = Top();
