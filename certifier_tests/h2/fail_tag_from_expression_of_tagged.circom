pragma circom 2.2.0;

// (H2) FAIL: `a * b` of two binary signals IS binary, but H2 is syntactic:
// a tag can only be established by a bare copy of an already-tagged
// source, never by an expression (no semantic reasoning about tags).
// @expect FAIL
// @certified 1
// @trusted IsZero()
// @fail MyAnd(null,null) CE02
// @circomlib IsZero

template MyAnd() {
    signal input {binary} a;
    signal input {binary} b;
    signal output {binary} out;
    out <== a * b;
}

template Top() {
    signal input x;
    signal input y;
    signal output {binary} out;
    out <== MyAnd()(IsZero()(x), IsZero()(y));
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ===== END circomlib =====

component main = Top();
