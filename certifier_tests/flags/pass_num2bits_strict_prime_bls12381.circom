pragma circom 2.2.0;

// (Flags) PASS with --prime bls12381: maxbits() follows the prime, the trusted
// templates are the same (their hash does not depend on the field).
// @expect PASS
// @certified 1
// @trusted AND(null,null)
// @trusted AliasCheck(null)
// @trusted CompConstant(255,52435875175126190479447740508185965837690552500527637822603658699938581184512,null)
// @trusted Num2Bits(255)
// @trusted Num2Bits_strict()
// @trusted OR(null,null)
// @args --prime bls12381
// @circomlib Num2Bits_strict

template Top() {
    signal input a;
    signal output {binary} bits[maxbits()];
    bits <== Num2Bits_strict()(a);
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/aliascheck.circom

template AliasCheck() {

    input signal {binary} in[maxbits()];

    component  compConstant = CompConstant(maxbits(), -1);

    compConstant.in <== in;

    compConstant.out === 0;
}

// ---- circuits/bitify.circom

function maxbits(){
    var n = 1;
    var r = 1;
    while(2 * n > n){
        n = n * 2;
        r = r + 1;
    }
    return r + 1;
}

function nbits(a) {
    if (a == 0){
       return 1;
    } else if (a < 0){ // in case a > p \ 2 -> we need maxbits()
       return(maxbits()); 
    } else{
        var n = 1;
        var r = 0;
    
        while (n-1<a && n >= 0) {
            r++;
            n *= 2;
        }
        if (n-1 < 0){
            return maxbits();
        }
        return r;
    }
}

template Num2Bits(n) {
    input signal in;
    output signal {binary} out[n];
    var lc1=0;

    var e2=1;
    for (var i = 0; i<n; i++) {
        out[i] <-- (in >> i) & 1;
        out[i] * (out[i] -1 ) === 0;
        lc1 += out[i] * e2;
        e2 = e2+e2;
    }
    
    lc1 === in;
}

template Num2Bits_strict() {
    
    var max_nbits = maxbits();
    
    input signal in;
    output signal {binary} out[max_nbits];

    component aliasCheck = AliasCheck();
    component n2b = Num2Bits(max_nbits);
    in ==> n2b.in;

    n2b.out ==> out;
    n2b.out ==> aliasCheck.in;
}

// ---- circuits/comparators.circom

template CompConstant(n,ct) {
    assert(nbits(ct) <= n);
    input signal {binary} in[n];
    output signal {binary} out;

    signal {binary} res[n];
    if (ct & 1 == 0) {
        res[0] <== in[0];
    } else {
        res[0] <== 0;
    }
    for (var i=1; i < n; i++) {
        // re[i-1] says if in[0..i-1] > ct[0..i-1] (upto bit i-1)
        if ((ct >> i) & 1 == 0) {
            res[i] <== OR()(res[i-1],in[i]);
        } else {
            res[i] <== AND()(res[i-1],in[i]);
	}
    }
    out <== res[n-1];
}

// ---- circuits/gates.circom

template AND() {
    input signal {binary} a;
    input signal {binary} b;
    output signal {binary} out;

    out <== a*b;
}

template OR() {
    input signal {binary} a;
    input signal {binary} b;
    output signal {binary} out;

    out <== a + b - a*b;
}

// ===== END circomlib =====

component main = Top();
