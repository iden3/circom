pragma circom 2.2.0;

// COMPILE_ERROR, the other half of h2/pass_inherited_maxbit_different_values:
// t's positions bring {maxbit} with values 4 and 8, circom drops the
// inherited value, `m` is left with a {maxbit} tag WITHOUT value, and
// LessThan's `assert(in.maxbit <= n)` cannot read it: circom stops the
// compilation. So keeping the tag name in -cbc never lets a wrong VALUE
// reach a consumer.
// @expect COMPILE_ERROR
// @error T3001
// @circomlib Num2Bits Bits2Num LessThan

template Top() {
    signal input a;
    signal input b;
    signal output o;
    signal t[2];
    t[0] <== Bits2Num(4)(Num2Bits(4)(a));
    t[1] <== Bits2Num(8)(Num2Bits(8)(b));
    signal {maxbit} m[2];
    m[0] <== t[0];
    m[1] <== t[1];
    o <== LessThan(8)(m);
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/bitify.circom

function maxbits(){
    var n = 1;
    var r = 1;
    while(2 * n > n){
        n = n * 2;
        r = r + 1;
    }
    return r + 1;
}

template Num2Bits(n) {
    input signal in;
    output signal {binary} out[n];
    var lc1=0;

    var e2=1;
    for (var i = 0; i<n; i++) {
        out[i] <-- (in >> i) & 1;
        out[i] * (out[i] -1 ) === 0;
        lc1 += out[i] * e2;
        e2 = e2+e2;
    }
    
    lc1 === in;
}

template Bits2Num(n) {
    input signal {binary} in[n];
    output signal {maxbit} out;
    var lc1=0;

    var e2 = 1;
    for (var i = 0; i<n; i++) {
        lc1 += in[i] * e2;
        e2 = e2 + e2;
    }
    out.maxbit = n;
    lc1 ==> out;
}

// ---- circuits/comparators.circom

template LessThan(n) {
    assert(n <= maxbits()-2);
    input signal {maxbit} in[2];
    output signal {binary} out;
    
    assert(in.maxbit <= n);

    component n2b = Num2Bits(n+1);

    n2b.in <== in[0]+ (1<<n) - in[1];

    out <== 1-n2b.out[n];
}

// ===== END circomlib =====

component main = Top();
