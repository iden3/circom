pragma circom 2.2.0;

// (Syntax + H2) FAIL: `(o1, o2) <== (z, a * a)` is split per component:
// o1 is a bare copy of a tagged signal, o2 comes from an expression.
// Exactly one CE02, on o2.
// @expect FAIL
// @certified 0
// @trusted IsZero()
// @fail T() CE02
// @circomlib IsZero

template T() {
    signal input a;
    signal output {binary} o1;
    signal output {binary} o2;
    signal {binary} z <== IsZero()(a);
    (o1, o2) <== (z, a * a);
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ===== END circomlib =====

component main = T();
