pragma circom 2.2.0;

// (Syntax + H3) PASS: `_ <== Num2Bits(8)(a)` discards the bits and keeps
// only the range check (the same idiom circomlib's MaxbitCheck uses).
// @expect PASS
// @certified 1
// @trusted Num2Bits(8)
// @circomlib Num2Bits

template Top() {
    signal input a;
    signal output out;
    _ <== Num2Bits(8)(a);
    out <== a;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/bitify.circom

template Num2Bits(n) {
    input signal in;
    output signal {binary} out[n];
    var lc1=0;

    var e2=1;
    for (var i = 0; i<n; i++) {
        out[i] <-- (in >> i) & 1;
        out[i] * (out[i] -1 ) === 0;
        lc1 += out[i] * e2;
        e2 = e2+e2;
    }
    
    lc1 === in;
}

// ===== END circomlib =====

component main = Top();
