pragma circom 2.2.0;

// (Syntax + H3) PASS: an array of circomlib components.
// @expect PASS
// @certified 1
// @trusted IsZero()
// @circomlib IsZero

template Top() {
    signal input a[3];
    signal output {binary} o[3];
    component z[3];
    for (var i = 0; i < 3; i++) {
        z[i] = IsZero();
        z[i].in <== a[i];
        o[i] <== z[i].out;
    }
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ===== END circomlib =====

component main = Top();
