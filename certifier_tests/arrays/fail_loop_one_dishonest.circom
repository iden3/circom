pragma circom 2.2.0;

// (Arrays of buses) FAIL: honest loop plus one extra overwrite path in an
// if: element 2 comes from an expression. One CE02.
// @expect FAIL
// @certified 0
// @trusted Num2Bits(4)
// @fail Top() CE02
// @circomlib Num2Bits

bus Inner {
    signal {binary} x;
}

template Top() {
    signal input a;
    signal {binary} bits[4] <== Num2Bits(4)(a);
    output Inner() arr[4];
    for (var i = 0; i < 4; i++) {
        if (i == 2) {
            arr[i].x <== 1 - bits[i];
        } else {
            arr[i].x <== bits[i];
        }
    }
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/bitify.circom

template Num2Bits(n) {
    input signal in;
    output signal {binary} out[n];
    var lc1=0;

    var e2=1;
    for (var i = 0; i<n; i++) {
        out[i] <-- (in >> i) & 1;
        out[i] * (out[i] -1 ) === 0;
        lc1 += out[i] * e2;
        e2 = e2+e2;
    }
    
    lc1 === in;
}

// ===== END circomlib =====

component main = Top();
