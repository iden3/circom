pragma circom 2.2.0;

// (Arrays of buses) FAIL: arr[0].x honest, arr[1].x bare. Every index
// collapses into the path `arr.x` and one dishonest touch poisons it:
// exactly one CE02.
// @expect FAIL
// @certified 0
// @trusted IsZero()
// @fail ArrOfBuses() CE02
// @circomlib IsZero

bus Inner {
    signal {binary} x;
}

template ArrOfBuses() {
    signal input a;
    signal input b;
    component z = IsZero();
    z.in <== a;

    Inner() arr[2];
    arr[0].x <== z.out;
    arr[1].x <== b * 2;

    signal output out;
    out <== arr[0].x;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ===== END circomlib =====

component main = ArrOfBuses();
