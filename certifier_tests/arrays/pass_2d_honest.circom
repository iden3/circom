pragma circom 2.2.0;

// (Arrays of buses) PASS: a 2-D array of buses, all elements honest.
// @expect PASS
// @certified 1
// @trusted Num2Bits(4)
// @circomlib Num2Bits

bus Inner {
    signal {binary} x;
}

template Top() {
    signal input a;
    signal {binary} bits[4] <== Num2Bits(4)(a);
    output Inner() m[2][2];
    for (var i = 0; i < 2; i++) {
        for (var j = 0; j < 2; j++) {
            m[i][j].x <== bits[2*i + j];
        }
    }
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/bitify.circom

template Num2Bits(n) {
    input signal in;
    output signal {binary} out[n];
    var lc1=0;

    var e2=1;
    for (var i = 0; i<n; i++) {
        out[i] <-- (in >> i) & 1;
        out[i] * (out[i] -1 ) === 0;
        lc1 += out[i] * e2;
        e2 = e2+e2;
    }
    
    lc1 === in;
}

// ===== END circomlib =====

component main = Top();
