pragma circom 2.2.0;

// (Arrays of buses) FAIL: a 2-D array of buses, m[1][1] dishonest. One CE02.
// @expect FAIL
// @certified 0
// @trusted Num2Bits(4)
// @fail Top() CE02
// @circomlib Num2Bits

bus Inner {
    signal {binary} x;
}

template Top() {
    signal input a;
    signal {binary} bits[4] <== Num2Bits(4)(a);
    output Inner() m[2][2];
    m[0][0].x <== bits[0];
    m[0][1].x <== bits[1];
    m[1][0].x <== bits[2];
    m[1][1].x <== bits[3] * bits[3];
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/bitify.circom

template Num2Bits(n) {
    input signal in;
    output signal {binary} out[n];
    var lc1=0;

    var e2=1;
    for (var i = 0; i<n; i++) {
        out[i] <-- (in >> i) & 1;
        out[i] * (out[i] -1 ) === 0;
        lc1 += out[i] * e2;
        e2 = e2+e2;
    }
    
    lc1 === in;
}

// ===== END circomlib =====

component main = Top();
