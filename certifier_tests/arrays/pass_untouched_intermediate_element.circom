pragma circom 2.2.0;

// (Arrays of buses) PASS on purpose: arr[1].x is never touched. H2 cannot
// see it (it collapses with arr[0].x into `arr.x`). The structural analysis
// does see it (CA01 warning), but `arr` is an intermediate signal nobody
// reads, so it cannot make any output non-deterministic: the warning is
// not promoted to a certification failure.
// @expect PASS
// @certified 1
// @trusted IsZero()
// @circomlib IsZero

bus Inner {
    signal {binary} x;
}

template ArrOfBuses() {
    signal input a;
    component z = IsZero();
    z.in <== a;

    Inner() arr[2];
    arr[0].x <== z.out;
    // arr[1].x intentionally left untouched.

    signal output out;
    out <== arr[0].x;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ===== END circomlib =====

component main = ArrOfBuses();
