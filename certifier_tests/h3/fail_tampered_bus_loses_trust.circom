pragma circom 2.2.0;

// (H3) FAIL, regression test for a closed soundness hole: only the BUS
// `BinaryNumber` is modified (extra field `extra`, never written by
// Num2Bin, so unconstrained, and copied by Top into its output `o`). Trust
// covers the bus types a template uses, so Num2Bin loses trust (CW01 names
// `bus BinaryNumber`) and is checked as ordinary code: CE01 (`<--`), CE02
// on `out` and `out.bits`, and CA01 on the unconstrained output field,
// flagged as NOT safe. Even with a table that trusted this bus, the CA01
// would still be reported (an unconstrained output is never covered by
// trust).
// @expect FAIL
// @certified 1
// @fail Num2Bin(8) CE01 CE02 CE02 CA01
// @circomlib Num2Bin -BinaryNumber

bus BinaryNumber(n){
    signal {binary} bits[n];
    signal extra;
}

template Top() {
    signal input a;
    signal output o;
    component c = Num2Bin(8);
    c.in <== a;
    o <== c.out.extra;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/aliascheck.circom

template AliasCheck() {

    input signal {binary} in[maxbits()];

    component  compConstant = CompConstant(maxbits(), -1);

    compConstant.in <== in;

    compConstant.out === 0;
}

// ---- circuits/binnum.circom

template Num2Bin(n) {
    assert(n <= maxbits()); // otherwise the tag unique cannot be guaranteed
    signal input in;
    BinaryNumber(n) output {unique} out;
    var lc1=0;

    var e2=1;
    for (var i = 0; i<n; i++) {
        out.bits[i] <-- (in >> i) & 1;
        out.bits[i] * (out.bits[i] -1 ) === 0;
        lc1 += out.bits[i] * e2;
        e2 = e2+e2;
    }
    lc1 === in;
    
    if (n >= maxbits()) {
       component aliasCheck = AliasCheck();
       aliasCheck.in <== out.bits;
    }
}

// ---- circuits/bitify.circom

function maxbits(){
    var n = 1;
    var r = 1;
    while(2 * n > n){
        n = n * 2;
        r = r + 1;
    }
    return r + 1;
}

function nbits(a) {
    if (a == 0){
       return 1;
    } else if (a < 0){ // in case a > p \ 2 -> we need maxbits()
       return(maxbits()); 
    } else{
        var n = 1;
        var r = 0;
    
        while (n-1<a && n >= 0) {
            r++;
            n *= 2;
        }
        if (n-1 < 0){
            return maxbits();
        }
        return r;
    }
}

// ---- circuits/comparators.circom

template CompConstant(n,ct) {
    assert(nbits(ct) <= n);
    input signal {binary} in[n];
    output signal {binary} out;

    signal {binary} res[n];
    if (ct & 1 == 0) {
        res[0] <== in[0];
    } else {
        res[0] <== 0;
    }
    for (var i=1; i < n; i++) {
        // re[i-1] says if in[0..i-1] > ct[0..i-1] (upto bit i-1)
        if ((ct >> i) & 1 == 0) {
            res[i] <== OR()(res[i-1],in[i]);
        } else {
            res[i] <== AND()(res[i-1],in[i]);
	}
    }
    out <== res[n-1];
}

// ---- circuits/gates.circom

template AND() {
    input signal {binary} a;
    input signal {binary} b;
    output signal {binary} out;

    out <== a*b;
}

template OR() {
    input signal {binary} a;
    input signal {binary} b;
    output signal {binary} out;

    out <== a + b - a*b;
}

// ===== END circomlib =====

component main = Top();
