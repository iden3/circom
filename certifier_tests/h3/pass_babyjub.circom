pragma circom 2.2.0;

// (H3) PASS: Baby Jubjub with circomlib2 buses. BabyCheck turns a plain
// Point into a {babyedwards} Point; BabyAdd and BabyDbl (which instantiates
// BabyAdd) use `<--` for the divisions but are trusted.
// @expect PASS
// @certified 1
// @trusted BabyAdd(null,null)
// @trusted BabyCheck()
// @trusted BabyDbl(null)
// @circomlib BabyCheck BabyAdd BabyDbl

template Top() {
    input Point() p;
    input Point() q;
    output Point() {babyedwards} sum;
    output Point() {babyedwards} dbl;
    Point() {babyedwards} pp <== BabyCheck()(p);
    Point() {babyedwards} qq <== BabyCheck()(q);
    sum <== BabyAdd()(pp, qq);
    dbl <== BabyDbl()(pp);
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/babyjub.circom

template BabyAdd() {
    input Point {babyedwards} pin1,pin2;
    output Point {babyedwards} pout;

    signal beta;
    signal gamma;
    signal delta;
    signal tau;

    var a = 168700;
    var d = 168696;

    beta <== pin1.x*pin2.y;
    gamma <== pin1.y*pin2.x;
    delta <== (-a*pin1.x + pin1.y)*(pin2.x + pin2.y);
    tau <== beta * gamma;

    pout.x <-- (beta + gamma) / (1 + d*tau);
    (1 + d*tau) * pout.x === (beta + gamma);

    pout.y <-- (delta + a*beta - gamma) / (1 - d*tau);
    (1 - d*tau)*pout.y === (delta + a*beta - gamma);
}

template BabyDbl() {
    input Point {babyedwards} pin;
    output Point {babyedwards} pout;

    component adder = BabyAdd();

    adder.pin1 <== pin;
    adder.pin2 <== pin;
    adder.pout ==> pout;
}

template BabyCheck() {
    input Point pin;
    output Point {babyedwards} pout;

    // Point p2;
    signal x2;
    signal y2;

    var a = 168700;
    var d = 168696;

    x2 <== pin.x*pin.x; //x2 = pin.x^2
    y2 <== pin.y*pin.y; //y2 = pin.y^2
    
    a*x2 + y2 === 1 + d*x2*y2;
    
    pout <== pin; 
}

// ---- circuits/buses.circom

bus Point(){
    signal x;
    signal y;
}

// ===== END circomlib =====

component main = Top();
