pragma circom 2.2.0;

// (H3) PASS: Point2Bits_Strict -> Bits2Point_Strict round trip through a
// BinaryPoint(254) bus (with {binary} fields), using sqrt() and AliasCheck.
// @expect PASS
// @certified 1
// @trusted AND(null,null)
// @trusted AliasCheck(null)
// @trusted BabyCheck()
// @trusted Bits2Num(254,null)
// @trusted Bits2Point_Strict()
// @trusted CompConstant(254,10944121435919637611123202872628637544274182200208017171849102093287904247808,null)
// @trusted CompConstant(254,21888242871839275222246405745257275088548364400416034343698204186575808495616,null)
// @trusted Num2Bits(254)
// @trusted OR(null,null)
// @trusted Point2Bits_Strict()
// @circomlib Point2Bits_Strict Bits2Point_Strict

template Top() {
    input Point() p;
    output Point() {babyedwards} q;
    BinaryPoint(254) b <== Point2Bits_Strict()(p);
    q <== Bits2Point_Strict()(b);
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/aliascheck.circom

template AliasCheck() {

    input signal {binary} in[maxbits()];

    component  compConstant = CompConstant(maxbits(), -1);

    compConstant.in <== in;

    compConstant.out === 0;
}

// ---- circuits/babyjub.circom

template BabyCheck() {
    input Point pin;
    output Point {babyedwards} pout;

    // Point p2;
    signal x2;
    signal y2;

    var a = 168700;
    var d = 168696;

    x2 <== pin.x*pin.x; //x2 = pin.x^2
    y2 <== pin.y*pin.y; //y2 = pin.y^2
    
    a*x2 + y2 === 1 + d*x2*y2;
    
    pout <== pin; 
}

// ---- circuits/bitify.circom

function maxbits(){
    var n = 1;
    var r = 1;
    while(2 * n > n){
        n = n * 2;
        r = r + 1;
    }
    return r + 1;
}

function nbits(a) {
    if (a == 0){
       return 1;
    } else if (a < 0){ // in case a > p \ 2 -> we need maxbits()
       return(maxbits()); 
    } else{
        var n = 1;
        var r = 0;
    
        while (n-1<a && n >= 0) {
            r++;
            n *= 2;
        }
        if (n-1 < 0){
            return maxbits();
        }
        return r;
    }
}

template Num2Bits(n) {
    input signal in;
    output signal {binary} out[n];
    var lc1=0;

    var e2=1;
    for (var i = 0; i<n; i++) {
        out[i] <-- (in >> i) & 1;
        out[i] * (out[i] -1 ) === 0;
        lc1 += out[i] * e2;
        e2 = e2+e2;
    }
    
    lc1 === in;
}

template Bits2Num(n) {
    input signal {binary} in[n];
    output signal {maxbit} out;
    var lc1=0;

    var e2 = 1;
    for (var i = 0; i<n; i++) {
        lc1 += in[i] * e2;
        e2 = e2 + e2;
    }
    out.maxbit = n;
    lc1 ==> out;
}

// ---- circuits/buses.circom

bus Point(){
    signal x;
    signal y;
}

bus BinaryPoint(n) {
    signal {binary} binY[n];
    signal {binary} signX;
}

// ---- circuits/comparators.circom

template CompConstant(n,ct) {
    assert(nbits(ct) <= n);
    input signal {binary} in[n];
    output signal {binary} out;

    signal {binary} res[n];
    if (ct & 1 == 0) {
        res[0] <== in[0];
    } else {
        res[0] <== 0;
    }
    for (var i=1; i < n; i++) {
        // re[i-1] says if in[0..i-1] > ct[0..i-1] (upto bit i-1)
        if ((ct >> i) & 1 == 0) {
            res[i] <== OR()(res[i-1],in[i]);
        } else {
            res[i] <== AND()(res[i-1],in[i]);
	}
    }
    out <== res[n-1];
}

// ---- circuits/gates.circom

template AND() {
    input signal {binary} a;
    input signal {binary} b;
    output signal {binary} out;

    out <== a*b;
}

template OR() {
    input signal {binary} a;
    input signal {binary} b;
    output signal {binary} out;

    out <== a + b - a*b;
}

// ---- circuits/pointbits.circom

function sqrt(n) {

    if (n == 0) {
        return 0;
    }

    // Test that have solution
    var res = n ** ((-1) >> 1);
//        if (res!=1) assert(false, "SQRT does not exists");
    if (res!=1) return 0;

    var m = 28;
    var c = 19103219067921713944291392827692070036145651957329286315305642004821462161904;
    var t = n ** 81540058820840996586704275553141814055101440848469862132140264610111;
    var r = n ** ((81540058820840996586704275553141814055101440848469862132140264610111+1)>>1);
    var sq;
    var i;
    var b;
    var j;

    while ((r != 0)&&(t != 1)) {
        sq = t*t;
        i = 1;
        while (sq!=1) {
            i++;
            sq = sq*sq;
        }

        // b = c ^ m-i-1
        b = c;
        for (j=0; j< m-i-1; j ++) b = b*b;

        m = i;
        c = b*b;
        t = t*c;
        r = r*b;
    }

    if (r < 0 ) {
        r = -r;
    }

    return r;
}

template Bits2Point_Strict() {
    BinaryPoint(254) input in;
    output Point {babyedwards} pout;

    var i;

    // Check aliasing
    component aliasCheckY = AliasCheck();
    aliasCheckY.in <== in.binY;

    component b2nY = Bits2Num(254);
    b2nY.in <== in.binY;

    pout.y <== b2nY.out;

    var a = 168700;
    var d = 168696;

    var y2 = pout.y * pout.y;

    var x = sqrt(   (1-y2)/(a - d*y2)  );

    if (in.signX == 1) x = -x;

    pout.x <-- x;

    component babyCheck = BabyCheck();
    babyCheck.pin <== pout;

    component n2bX = Num2Bits(254);
    n2bX.in <== pout.x;
    component aliasCheckX = AliasCheck();
    aliasCheckX.in <== n2bX.out;

    component signCalc = CompConstant(maxbits(), 10944121435919637611123202872628637544274182200208017171849102093287904247808);
    signCalc.in <== n2bX.out;

    signCalc.out === in.signX;
}

template Point2Bits_Strict() {
    input Point pin;
    BinaryPoint(254) output out;

    var i;

    component n2bX = Num2Bits(254);
    n2bX.in <== pin.x;
    component n2bY = Num2Bits(254);
    n2bY.in <== pin.y;

    component aliasCheckX = AliasCheck();
    component aliasCheckY = AliasCheck();
    aliasCheckX.in <== n2bX.out;
    aliasCheckY.in <== n2bY.out;

    component signCalc = CompConstant(maxbits(), 10944121435919637611123202872628637544274182200208017171849102093287904247808);
    signCalc.in <== n2bX.out;

    out.binY <== n2bY.out;
    out.signX <== signCalc.out;
}

// ===== END circomlib =====

component main = Top();
