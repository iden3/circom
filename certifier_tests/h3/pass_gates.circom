pragma circom 2.2.0;

// (H3) PASS: every binary gate of gates.circom, fed by IsZero.
// @expect PASS
// @certified 1
// @trusted AND(null,null)
// @trusted IsZero()
// @trusted NAND(null,null)
// @trusted NOR(null,null)
// @trusted NOT(null)
// @trusted OR(null,null)
// @trusted XOR(null,null)
// @circomlib IsZero XOR AND OR NOT NAND NOR

template Top() {
    signal input x;
    signal input y;
    signal output {binary} o[6];
    signal {binary} a <== IsZero()(x);
    signal {binary} b <== IsZero()(y);
    o[0] <== XOR()(a, b);
    o[1] <== AND()(a, b);
    o[2] <== OR()(a, b);
    o[3] <== NOT()(a);
    o[4] <== NAND()(a, b);
    o[5] <== NOR()(a, b);
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ---- circuits/gates.circom

template XOR() {
    input signal {binary} a;
    input signal {binary} b;
    output signal {binary} out;

    out <== a + b - 2*a*b;
}

template AND() {
    input signal {binary} a;
    input signal {binary} b;
    output signal {binary} out;

    out <== a*b;
}

template OR() {
    input signal {binary} a;
    input signal {binary} b;
    output signal {binary} out;

    out <== a + b - a*b;
}

template NOT() {
    input signal {binary} in;
    output signal {binary} out;

    out <== 1 + in - 2*in;
}

template NAND() {
    input signal {binary} a;
    input signal {binary} b;
    output signal {binary} out;

    out <== 1 - a*b;
}

template NOR() {
    input signal {binary} a;
    input signal {binary} b;
    output signal {binary} out;

    out <== a*b + 1 - a - b;
}

// ===== END circomlib =====

component main = Top();
