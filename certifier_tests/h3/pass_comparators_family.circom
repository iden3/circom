pragma circom 2.2.0;

// (H3) PASS: GreaterThan, LessEqThan and GreaterEqThan over {maxbit}
// inputs produced by Num2Bits -> Bits2Num. Every instance comes from
// pristine circomlib2.
// @expect PASS
// @certified 1
// @trusted Bits2Num(8,null)
// @trusted GreaterEqThan(8,8)
// @trusted GreaterThan(8,8)
// @trusted LessEqThan(8,8)
// @trusted LessThan(8,8)
// @trusted NOT(null)
// @trusted Num2Bits(8)
// @trusted Num2Bits(9)
// @circomlib Num2Bits Bits2Num GreaterThan LessEqThan GreaterEqThan

template Top() {
    signal input a;
    signal input b;
    signal output gt;
    signal output le;
    signal output ge;

    signal {maxbit} x[2];
    x[0] <== Bits2Num(8)(Num2Bits(8)(a));
    x[1] <== Bits2Num(8)(Num2Bits(8)(b));

    gt <== GreaterThan(8)(x);
    le <== LessEqThan(8)(x);
    ge <== GreaterEqThan(8)(x);
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/bitify.circom

function maxbits(){
    var n = 1;
    var r = 1;
    while(2 * n > n){
        n = n * 2;
        r = r + 1;
    }
    return r + 1;
}

template Num2Bits(n) {
    input signal in;
    output signal {binary} out[n];
    var lc1=0;

    var e2=1;
    for (var i = 0; i<n; i++) {
        out[i] <-- (in >> i) & 1;
        out[i] * (out[i] -1 ) === 0;
        lc1 += out[i] * e2;
        e2 = e2+e2;
    }
    
    lc1 === in;
}

template Bits2Num(n) {
    input signal {binary} in[n];
    output signal {maxbit} out;
    var lc1=0;

    var e2 = 1;
    for (var i = 0; i<n; i++) {
        lc1 += in[i] * e2;
        e2 = e2 + e2;
    }
    out.maxbit = n;
    lc1 ==> out;
}

// ---- circuits/comparators.circom

template LessThan(n) {
    assert(n <= maxbits()-2);
    input signal {maxbit} in[2];
    output signal {binary} out;
    
    assert(in.maxbit <= n);

    component n2b = Num2Bits(n+1);

    n2b.in <== in[0]+ (1<<n) - in[1];

    out <== 1-n2b.out[n];
}

template LessEqThan(n){
    input signal {maxbit} in[2];
    output signal {binary} out;
    assert(in.maxbit <= n);

    component gt = GreaterThan(n);
    gt.in <== in;
    
    component nt = NOT();
    nt.in <== gt.out;
    nt.out ==> out;

}

template GreaterThan(n) {
    input signal {maxbit} in[2];
    output signal {binary} out;
    
    assert(in.maxbit <= n);

    component lt = LessThan(n);

    lt.in[0] <== in[1];
    lt.in[1] <== in[0];
    lt.out ==> out;
}

template GreaterEqThan(n) {
    input signal {maxbit} in[2];
    output signal {binary} out;
    
    assert(in.maxbit <= n);

    component gt = LessThan(n);
    gt.in <== in;
    
    component nt = NOT();
    nt.in <== gt.out;
    nt.out ==> out;
}

// ---- circuits/gates.circom

template NOT() {
    input signal {binary} in;
    output signal {binary} out;

    out <== 1 + in - 2*in;
}

// ===== END circomlib =====

component main = Top();
