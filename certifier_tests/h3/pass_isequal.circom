pragma circom 2.2.0;

// (H3) PASS: IsEqual instantiates IsZero; both pristine, both trusted.
// @expect PASS
// @certified 1
// @trusted IsEqual()
// @trusted IsZero()
// @circomlib IsEqual

template Top() {
    signal input a;
    signal input b;
    signal output {binary} eq;
    eq <== IsEqual()([a, b]);
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

template IsEqual() {
    input signal in[2];
    output signal {binary} out;

    component isz = IsZero();

    in[1] - in[0] ==> isz.in;

    isz.out ==> out;
}

// ===== END circomlib =====

component main = Top();
