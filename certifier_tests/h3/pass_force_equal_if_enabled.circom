pragma circom 2.2.0;

// (H3) PASS: ForceEqualIfEnabled needs a {binary} `enabled`, produced here
// by another trusted template (IsZero).
// @expect PASS
// @certified 1
// @trusted ForceEqualIfEnabled(null)
// @trusted IsZero()
// @circomlib ForceEqualIfEnabled

template Top() {
    signal input sel;
    signal input a;
    signal input b;
    signal output out;
    component f = ForceEqualIfEnabled();
    f.enabled <== IsZero()(sel);
    f.in <== [a, b];
    out <== a;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

template ForceEqualIfEnabled() {
    input signal {binary} enabled;
    input signal in[2];

    component isz = IsZero();

    in[1] - in[0] ==> isz.in;

    (1 - isz.out)*enabled === 0;
}

// ===== END circomlib =====

component main = Top();
