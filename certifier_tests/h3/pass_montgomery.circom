pragma circom 2.2.0;

// (H3) PASS: Edwards <-> Montgomery conversions, MontgomeryAdd/Double and
// MontgomeryBabyCheck, all over tagged Point buses.
// @expect PASS
// @certified 1
// @trusted BabyCheck()
// @trusted Edwards2MontgomeryStrict(null)
// @trusted IsZero()
// @trusted Montgomery2Edwards(null)
// @trusted MontgomeryAdd(null,null)
// @trusted MontgomeryBabyCheck()
// @trusted MontgomeryDouble(null)
// @circomlib BabyCheck Edwards2MontgomeryStrict Montgomery2Edwards MontgomeryAdd MontgomeryDouble MontgomeryBabyCheck

template Top() {
    input Point() p;
    input Point() q;
    output Point() {babyedwards} e;
    Point() {babymontgomery} mp <== Edwards2MontgomeryStrict()(BabyCheck()(p));
    Point() {babymontgomery} mq <== MontgomeryBabyCheck()(q);
    Point() {babymontgomery} s <== MontgomeryAdd()(mp, mq);
    Point() {babymontgomery} d <== MontgomeryDouble()(s);
    e <== Montgomery2Edwards()(d);
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/babyjub.circom

template BabyCheck() {
    input Point pin;
    output Point {babyedwards} pout;

    // Point p2;
    signal x2;
    signal y2;

    var a = 168700;
    var d = 168696;

    x2 <== pin.x*pin.x; //x2 = pin.x^2
    y2 <== pin.y*pin.y; //y2 = pin.y^2
    
    a*x2 + y2 === 1 + d*x2*y2;
    
    pout <== pin; 
}

// ---- circuits/buses.circom

bus Point(){
    signal x;
    signal y;
}

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ---- circuits/montgomery.circom

template Edwards2MontgomeryStrict() {
    input Point {babyedwards} pin;
    output Point {babymontgomery} pout;

    pout.x <-- pin.y != -1 ? (1 + pin.y) / (1 - pin.y) : 0;
    pout.y <-- pin.x != 0 ? pout.x / pin.x : 0;

    pout.x * (1 - pin.y) === (1 + pin.y);
    pout.y * pin.x === pout.x;
    signal iszx <== IsZero()(pin.x);
    iszx * pout.y === 0; // this ensures that for point (0,-1) the result is (0,0)
}

template Montgomery2Edwards() {
    input Point {babymontgomery} pin;
    output Point {babyedwards} pout;

    pout.x <-- pin.x / pin.y;
    pout.y <-- (pin.x - 1) / (pin.x + 1);

    pout.x * pin.y === pin.x;
    pout.y * (pin.x + 1) === pin.x - 1;
}

template MontgomeryAdd() {
    input Point {babymontgomery} pin1, pin2;
    output Point {babymontgomery} pout;

    assert(pin1.x != 0 || pin1.y != 1); 
    assert(pin2.x != 0 || pin2.y != 1); 
    assert(pin1.x != pin2.x || pin1.y != pin2.y ); 

    var A = 168698;
    var B = 1;

    signal lamda;

    lamda <-- (pin2.y - pin1.y) / (pin2.x - pin1.x);
    lamda * (pin2.x - pin1.x) === pin2.y - pin1.y;

    pout.x <== B*lamda*lamda - A - pin1.x - pin2.x;
    pout.y <== lamda * (pin1.x - pout.x) - pin1.y;
}

template MontgomeryDouble() {
    input Point {babymontgomery} pin;
    output Point {babymontgomery} pout;

    assert(pin.x != 0 || pin.y != 1);
    
    var A = 168698;
    var B = 1;

    signal lamda;
    signal x1_2;

    x1_2 <== pin.x * pin.x;

    lamda <-- (3*x1_2 + 2*A*pin.x + 1) / (2*B*pin.y);
    lamda * (2*B*pin.y) === (3*x1_2 + 2*A*pin.x + 1);

    pout.x <== B*lamda*lamda - A - 2*pin.x;
    pout.y <== lamda * (pin.x - pout.x) - pin.y;
}

template MontgomeryBabyCheck(){
    input Point pin;
    output Point {babymontgomery} pout;
    
    var A = 168698;
    
    signal x_2 <== pin.x * pin.x;
    signal y_2 <== pin.y * pin.y;
    
    y_2 === x_2 * pin.x + A * x_2 + pin.x; 
    
    pin ==> pout;

}

// ===== END circomlib =====

component main = Top();
