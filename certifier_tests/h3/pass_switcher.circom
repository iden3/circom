pragma circom 2.2.0;

// (H3) PASS: Switcher with a {binary} selector.
// @expect PASS
// @certified 1
// @trusted IsZero()
// @trusted Switcher(null)
// @circomlib IsZero Switcher

template Top() {
    signal input sel;
    signal input l;
    signal input r;
    signal output outL;
    signal output outR;
    component sw = Switcher();
    sw.sel <== IsZero()(sel);
    sw.L <== l;
    sw.R <== r;
    outL <== sw.outL;
    outR <== sw.outR;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ---- circuits/switcher.circom

template Switcher() {
    input signal {binary} sel;
    input signal L;
    input signal R;
    output signal outL;
    output signal outR;

    signal aux;

    aux <== (R-L)*sel;    // We create aux in order to have only one multiplication
    outL <==  aux + L;
    outR <== -aux + R;
}

// ===== END circomlib =====

component main = Top();
