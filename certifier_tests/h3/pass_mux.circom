pragma circom 2.2.0;

// (H3) PASS: Mux1 and Mux2 (each instantiating its MultiMux) with {binary}
// selectors from Num2Bits.
// @expect PASS
// @certified 1
// @trusted MultiMux1(1,null)
// @trusted MultiMux2(1,null)
// @trusted Mux1(null)
// @trusted Mux2(null)
// @trusted Num2Bits(2)
// @circomlib Num2Bits Mux1 Mux2

template Top() {
    signal input c[4];
    signal input sel;
    signal output o1;
    signal output o2;
    signal {binary} s[2] <== Num2Bits(2)(sel);
    o1 <== Mux1()([c[0], c[1]], s[0]);
    o2 <== Mux2()(c, s);
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/bitify.circom

template Num2Bits(n) {
    input signal in;
    output signal {binary} out[n];
    var lc1=0;

    var e2=1;
    for (var i = 0; i<n; i++) {
        out[i] <-- (in >> i) & 1;
        out[i] * (out[i] -1 ) === 0;
        lc1 += out[i] * e2;
        e2 = e2+e2;
    }
    
    lc1 === in;
}

// ---- circuits/mux1.circom

template MultiMux1(n) {
    input signal c[n][2];  // Constants
    input signal {binary} s;   // Selector
    output signal out[n];

    for (var i=0; i<n; i++) {

        out[i] <== (c[i][1] - c[i][0])*s + c[i][0];

    }
}

template Mux1() {
    var i;
    input signal c[2];  // Constants
    input signal {binary} s;   // Selector
    output signal out;

    component mux = MultiMux1(1);

    for (i=0; i<2; i++) {
        mux.c[0][i] <== c[i];
    }

    s ==> mux.s;

    mux.out[0] ==> out;
}

// ---- circuits/mux2.circom

template MultiMux2(n) {
    input signal c[n][4];  // Constants
    input signal {binary} s[2];   // Selector
    output signal out[n];

    signal a10[n];
    signal a1[n];
    signal a0[n];
    signal a[n];

    signal  s10;
    s10 <== s[1] * s[0];

    for (var i=0; i<n; i++) {

          a10[i] <==  ( c[i][ 3]-c[i][ 2]-c[i][ 1]+c[i][ 0] ) * s10;
           a1[i] <==  ( c[i][ 2]-c[i][ 0] ) * s[1];
           a0[i] <==  ( c[i][ 1]-c[i][ 0] ) * s[0];
            a[i] <==  ( c[i][ 0] );

          out[i] <==  (  a10[i] +  a1[i] +  a0[i] +  a[i] );

    }
}

template Mux2() {
    var i;
    input signal c[4];  // Constants
    input signal {binary} s[2];   // Selector
    output signal out;

    component mux = MultiMux2(1);

    for (i=0; i<4; i++) {
        mux.c[0][i] <== c[i];
    }

    for (i=0; i<2; i++) {
      s[i] ==> mux.s[i];
    }

    mux.out[0] ==> out;
}

// ===== END circomlib =====

component main = Top();
