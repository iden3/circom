pragma circom 2.2.0;

// (H3) FAIL, recursive trust: Num2Bits lost its `out[i] * (out[i] -1 ) === 0;`
// line (unsound: the bits are no longer forced to be binary). LessThan,
// MaxbitCheck and MaxbitCheckArray are textually pristine, but they
// instantiate Num2Bits, so they lose trust as well and are checked as own
// code: MaxbitCheck (`out.maxbit = n; out <== in;`) and LessThan fail CE02;
// MaxbitCheckArray, which only copies MaxbitCheck's tagged outputs,
// certifies as own code (together with Top). Nothing is trusted.
// @expect FAIL
// @certified 2
// @fail Num2Bits(8) CE01 CE02
// @fail Num2Bits(9) CE01 CE02
// @fail MaxbitCheck(8) CE02
// @fail LessThan(8,8) CE02
// @circomlib MaxbitCheckArray LessThan -Num2Bits

template Num2Bits(n) {
    input signal in;
    output signal {binary} out[n];
    var lc1=0;

    var e2=1;
    for (var i = 0; i<n; i++) {
        out[i] <-- (in >> i) & 1;
        lc1 += out[i] * e2;
        e2 = e2+e2;
    }
    
    lc1 === in;
}

template Top() {
    signal input a;
    signal input b;
    signal output out;

    component mc = MaxbitCheckArray(8, 2);
    mc.in[0] <== a;
    mc.in[1] <== b;

    component lt = LessThan(8);
    lt.in <== mc.out;
    out <== lt.out;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/bitify.circom

function maxbits(){
    var n = 1;
    var r = 1;
    while(2 * n > n){
        n = n * 2;
        r = r + 1;
    }
    return r + 1;
}

// ---- circuits/comparators.circom

template LessThan(n) {
    assert(n <= maxbits()-2);
    input signal {maxbit} in[2];
    output signal {binary} out;
    
    assert(in.maxbit <= n);

    component n2b = Num2Bits(n+1);

    n2b.in <== in[0]+ (1<<n) - in[1];

    out <== 1-n2b.out[n];
}

// ---- circuits/tags-managing.circom

template MaxbitCheck(n) {
    input signal in;
    output signal {maxbit} out;
    
    _ <== Num2Bits(n)(in);

    out.maxbit = n;
    out <== in;
}

template MaxbitCheckArray(n,m) {
    input signal in[m];
    output signal {maxbit} out[m];

    out.maxbit = n;

    for (var i = 0; i < m; i++) {
       out[i] <== MaxbitCheck(n)(in[i]);
    }
    
}

// ===== END circomlib =====

component main = Top();
