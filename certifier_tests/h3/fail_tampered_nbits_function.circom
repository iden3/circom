pragma circom 2.2.0;

// (H3) FAIL: the function nbits() is modified in a way that does not even
// change its result for these inputs (an extra `+ 0`). Trust is about the
// audited text, not about guessing whether a change is harmless: BinSum,
// which calls nbits(), loses trust (CW01) and is checked as ordinary code
// (CE01 for its `<--`, CE02 for its {binary} out). Num2Bits does not call
// nbits() and stays trusted.
// @expect FAIL
// @certified 1
// @trusted Num2Bits(4)
// @fail BinSum(4,2,null) CE01 CE02
// @circomlib Num2Bits BinSum maxbits -nbits

function nbits(a) {
    if (a == 0){
       return 1;
    } else if (a < 0){
       return(maxbits());
    } else{
        var n = 1;
        var r = 0;
        while (n-1<a && n >= 0) {
            r++;
            n *= 2;
        }
        if (n-1 < 0){
            return maxbits();
        }
        return r + 0;
    }
}

template Top() {
    signal input a;
    signal input b;
    signal output {binary} out[5];
    component s = BinSum(4, 2);
    s.in[0] <== Num2Bits(4)(a);
    s.in[1] <== Num2Bits(4)(b);
    out <== s.out;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/binsum.circom

template BinSum(n, ops) {
    var nout = nbits((2**n -1)*ops);
    input signal {binary} in[ops][n];
    output signal {binary} out[nout];

    var lin = 0;
    var lout = 0;

    var k;
    var j;

    var e2;

    e2 = 1;
    for (k=0; k<n; k++) {
        for (j=0; j<ops; j++) {
            lin += in[j][k] * e2;
        }
        e2 = e2 + e2;
    }

    e2 = 1;
    for (k=0; k<nout; k++) {
        out[k] <-- (lin >> k) & 1;

        // Ensure out is binary
        out[k] * (out[k] - 1) === 0;

        lout += out[k] * e2;

        e2 = e2+e2;
    }

    // Ensure the sum;

    lin === lout;
}

// ---- circuits/bitify.circom

function maxbits(){
    var n = 1;
    var r = 1;
    while(2 * n > n){
        n = n * 2;
        r = r + 1;
    }
    return r + 1;
}

template Num2Bits(n) {
    input signal in;
    output signal {binary} out[n];
    var lc1=0;

    var e2=1;
    for (var i = 0; i<n; i++) {
        out[i] <-- (in >> i) & 1;
        out[i] * (out[i] -1 ) === 0;
        lc1 += out[i] * e2;
        e2 = e2+e2;
    }
    
    lc1 === in;
}

// ===== END circomlib =====

component main = Top();
