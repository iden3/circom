pragma circom 2.2.0;

// (H1 + H3) FAIL: the three possible outcomes side by side. Adder (own
// code) certifies, IsZero (circomlib2) is trusted, Broken (own code with a
// genuine `<--`) fails CE01 + CA01. Top itself certifies.
// @expect FAIL
// @certified 2
// @trusted IsZero()
// @fail Broken() CE01 CA01
// @circomlib IsZero

template Adder() {
    signal input a;
    signal input b;
    signal output out;
    out <== a + b;
}

template Broken() {
    signal input a;
    signal output out;
    out <-- a * 2;
}

template Top() {
    signal input a;
    signal input b;
    signal output sum;
    signal output isz;
    signal output broke;

    component add = Adder();
    add.a <== a;
    add.b <== b;
    sum <== add.out;

    component z = IsZero();
    z.in <== a;
    isz <== z.out;

    component brk = Broken();
    brk.a <== a;
    broke <== brk.out;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ===== END circomlib =====

component main = Top();
