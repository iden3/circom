pragma circom 2.2.0;

// (H3) FAIL, regression test for a closed soundness hole: only the
// FUNCTION `maxbits()` is modified (returns 300 instead of 254). LessThan's
// text is untouched, but its guard `assert(n <= maxbits()-2)` would now let
// the unsound LessThan(253) through (it decomposes into Num2Bits(254), not
// unique modulo p). Trust covers the functions a template calls, so
// LessThan loses trust (CW01 names `function maxbits()`) and, checked as
// ordinary code, its {binary} out (an expression) fails CE02. The templates
// that do not call maxbits() stay trusted.
// @expect FAIL
// @certified 1
// @trusted MaxbitCheckArray(253,2)
// @trusted MaxbitCheck(253)
// @trusted Num2Bits(253)
// @trusted Num2Bits(254)
// @fail LessThan(253,253) CE02
// @circomlib MaxbitCheckArray LessThan -maxbits

function maxbits(){
    return 300;
}

template Top() {
    signal input a;
    signal input b;
    signal output o;
    component mc = MaxbitCheckArray(253, 2);
    mc.in[0] <== a;
    mc.in[1] <== b;
    component lt = LessThan(253);
    lt.in <== mc.out;
    o <== lt.out;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/bitify.circom

template Num2Bits(n) {
    input signal in;
    output signal {binary} out[n];
    var lc1=0;

    var e2=1;
    for (var i = 0; i<n; i++) {
        out[i] <-- (in >> i) & 1;
        out[i] * (out[i] -1 ) === 0;
        lc1 += out[i] * e2;
        e2 = e2+e2;
    }
    
    lc1 === in;
}

// ---- circuits/comparators.circom

template LessThan(n) {
    assert(n <= maxbits()-2);
    input signal {maxbit} in[2];
    output signal {binary} out;
    
    assert(in.maxbit <= n);

    component n2b = Num2Bits(n+1);

    n2b.in <== in[0]+ (1<<n) - in[1];

    out <== 1-n2b.out[n];
}

// ---- circuits/tags-managing.circom

template MaxbitCheck(n) {
    input signal in;
    output signal {maxbit} out;
    
    _ <== Num2Bits(n)(in);

    out.maxbit = n;
    out <== in;
}

template MaxbitCheckArray(n,m) {
    input signal in[m];
    output signal {maxbit} out[m];

    out.maxbit = n;

    for (var i = 0; i < m; i++) {
       out[i] <== MaxbitCheck(n)(in[i]);
    }
    
}

// ===== END circomlib =====

component main = Top();
