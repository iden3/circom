pragma circom 2.2.0;

// (H3) PASS: one template, three instances; each instance is trusted.
// @expect PASS
// @certified 1
// @trusted Num2Bits(4)
// @trusted Num2Bits(8)
// @trusted Num2Bits(16)
// @circomlib Num2Bits

template Top() {
    signal input a;
    signal input b;
    signal input c;
    signal output {binary} x[4];
    signal output {binary} y[8];
    signal output {binary} z[16];
    x <== Num2Bits(4)(a);
    y <== Num2Bits(8)(b);
    z <== Num2Bits(16)(c);
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/bitify.circom

template Num2Bits(n) {
    input signal in;
    output signal {binary} out[n];
    var lc1=0;

    var e2=1;
    for (var i = 0; i<n; i++) {
        out[i] <-- (in >> i) & 1;
        out[i] * (out[i] -1 ) === 0;
        lc1 += out[i] * e2;
        e2 = e2+e2;
    }
    
    lc1 === in;
}

// ===== END circomlib =====

component main = Top();
