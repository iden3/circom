pragma circom 2.2.0;

// (H3) PASS: BinSub and Num2BitsNeg (which instantiates IsZero).
// @expect PASS
// @certified 1
// @trusted BinSub(8,null)
// @trusted IsZero()
// @trusted Num2Bits(8)
// @trusted Num2BitsNeg(8)
// @circomlib Num2Bits BinSub Num2BitsNeg

template Top() {
    signal input a;
    signal input b;
    signal output {binary} d[8];
    signal output {binary} n[8];
    component s = BinSub(8);
    s.in[0] <== Num2Bits(8)(a);
    s.in[1] <== Num2Bits(8)(b);
    d <== s.out;
    n <== Num2BitsNeg(8)(a);
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/binsub.circom

template BinSub(n) {
    input signal {binary} in[2][n];
    output signal {binary} out[n];

    signal aux;

    var lin = 2**n;
    var lout = 0;

    var i;

    for (i=0; i<n; i++) {
        lin = lin + in[0][i]*(2**i);
        lin = lin - in[1][i]*(2**i);
    }

    for (i=0; i<n; i++) {
        out[i] <-- (lin >> i) & 1;

        // Ensure out is binary
        out[i] * (out[i] - 1) === 0;

        lout = lout + out[i]*(2**i);
    }

    aux <-- (lin >> n) & 1;
    aux*(aux-1) === 0;
    lout = lout + aux*(2**n);

    // Ensure the sum;
    lin === lout;
}

// ---- circuits/bitify.circom

template Num2Bits(n) {
    input signal in;
    output signal {binary} out[n];
    var lc1=0;

    var e2=1;
    for (var i = 0; i<n; i++) {
        out[i] <-- (in >> i) & 1;
        out[i] * (out[i] -1 ) === 0;
        lc1 += out[i] * e2;
        e2 = e2+e2;
    }
    
    lc1 === in;
}

template Num2BitsNeg(n) {
    input signal in;
    output signal {binary} out[n];
    var lc1=0;

    component isZero;

    isZero = IsZero();

    var neg0 = in == 0 ? 0 : 2**n - in; // Fix to meet specification
    var neg = n == 0 ? 0 : neg0;

    for (var i = 0; i<n; i++) {
        out[i] <-- (neg >> i) & 1;
        out[i] * (out[i] -1 ) === 0;
        lc1 += out[i] * 2**i;
    }

    in ==> isZero.in;



    lc1 + isZero.out * 2**n === 2**n - in;
}

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ===== END circomlib =====

component main = Top();
