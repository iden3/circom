pragma circom 2.2.0;

// (H3) PASS: MultiAND(5) recursively instantiates MultiAND(2), MultiAND(3),
// MultiAND(1) and AND; all trusted.
// @expect PASS
// @certified 1
// @trusted AND(null,null)
// @trusted MultiAND(1,null)
// @trusted MultiAND(2,null)
// @trusted MultiAND(3,null)
// @trusted MultiAND(5,null)
// @trusted Num2Bits(5)
// @circomlib Num2Bits MultiAND

template Top() {
    signal input a;
    signal output {binary} out;
    out <== MultiAND(5)(Num2Bits(5)(a));
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/bitify.circom

template Num2Bits(n) {
    input signal in;
    output signal {binary} out[n];
    var lc1=0;

    var e2=1;
    for (var i = 0; i<n; i++) {
        out[i] <-- (in >> i) & 1;
        out[i] * (out[i] -1 ) === 0;
        lc1 += out[i] * e2;
        e2 = e2+e2;
    }
    
    lc1 === in;
}

// ---- circuits/gates.circom

template AND() {
    input signal {binary} a;
    input signal {binary} b;
    output signal {binary} out;

    out <== a*b;
}

template MultiAND(n) {
    input signal {binary} in[n];
    output signal {binary} out;
    component and1;
    component and2;
    component ands[2];
    if (n==1) {
        out <== in[0];
    } else if (n==2) {
        and1 = AND();
        and1.a <== in[0];
        and1.b <== in[1];
        out <== and1.out;
    } else {
        and2 = AND();
        var n1 = n\2;
        var n2 = n-n\2;
        ands[0] = MultiAND(n1);
        ands[1] = MultiAND(n2);
        var i;
        for (i=0; i<n1; i++) ands[0].in[i] <== in[i];
        for (i=0; i<n2; i++) ands[1].in[i] <== in[n1+i];
        and2.a <== ands[0].out;
        and2.b <== ands[1].out;
        out <== and2.out;
    }
}

// ===== END circomlib =====

component main = Top();
