pragma circom 2.2.0;

// (Buses) Should PASS, currently FAILS. Relay is OWN code and certifies: it
// copies its {babyedwards} input bus into its {babyedwards} output bus. Top
// then copies Relay's output bus (bare `<==`) into its own {babyedwards}
// output, which is an honest source (the callee's declared tag, exactly as
// for scalar signals), yet -cbc reports CE02 on `r`. The same pattern with a
// scalar tagged signal passes (h2/pass_tag_from_subcomponent_output.circom).
// @expect PASS
// @certified 2
// @trusted BabyCheck()
// @known-bug a bus with a bus-level tag is never an honest source (not even as an input) -> spurious CE02
// @circomlib BabyCheck

template Relay() {
    input Point() {babyedwards} p;
    output Point() {babyedwards} o;
    o <== p;
}

template Top() {
    input Point() p;
    output Point() {babyedwards} r;
    component bc = BabyCheck();
    bc.pin <== p;
    component rl = Relay();
    rl.p <== bc.pout;
    r <== rl.o;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/babyjub.circom

template BabyCheck() {
    input Point pin;
    output Point {babyedwards} pout;

    // Point p2;
    signal x2;
    signal y2;

    var a = 168700;
    var d = 168696;

    x2 <== pin.x*pin.x; //x2 = pin.x^2
    y2 <== pin.y*pin.y; //y2 = pin.y^2
    
    a*x2 + y2 === 1 + d*x2*y2;
    
    pout <== pin; 
}

// ---- circuits/buses.circom

bus Point(){
    signal x;
    signal y;
}

// ===== END circomlib =====

component main = Top();
