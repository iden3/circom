pragma circom 2.2.0;

// (Buses) PASS: a {binary} field declared in the bus TYPE, written with a
// bare copy of a tagged signal.
// @expect PASS
// @certified 1
// @trusted IsZero()
// @circomlib IsZero

bus Flag() {
    signal {binary} x;
    signal payload;
}

template Top() {
    signal input a;
    signal input p;
    output Flag() out;
    out.x <== IsZero()(a);
    out.payload <== p * p;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ===== END circomlib =====

component main = Top();
