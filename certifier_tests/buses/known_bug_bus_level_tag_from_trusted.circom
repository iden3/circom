pragma circom 2.2.0;

// (Buses + H3) Should PASS, currently FAILS. Same as
// pass_whole_bus_copy_field_tags_only.circom, but the destination bus also
// declares the bus-level tag {unique}, which Num2Bin's output declares too.
// A bare whole-bus copy from a trusted subcomponent output is an honest
// source, yet -cbc reports CE02 on `r` and on `r.bits`.
// @expect PASS
// @certified 1
// @trusted Num2Bin(8)
// @known-bug a bus with a bus-level tag is never an honest source (not even as an input) -> spurious CE02
// @circomlib Num2Bin

template Top() {
    signal input a;
    output BinaryNumber(8) {unique} r;
    component c = Num2Bin(8);
    c.in <== a;
    r <== c.out;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/aliascheck.circom

template AliasCheck() {

    input signal {binary} in[maxbits()];

    component  compConstant = CompConstant(maxbits(), -1);

    compConstant.in <== in;

    compConstant.out === 0;
}

// ---- circuits/binnum.circom

template Num2Bin(n) {
    assert(n <= maxbits()); // otherwise the tag unique cannot be guaranteed
    signal input in;
    BinaryNumber(n) output {unique} out;
    var lc1=0;

    var e2=1;
    for (var i = 0; i<n; i++) {
        out.bits[i] <-- (in >> i) & 1;
        out.bits[i] * (out.bits[i] -1 ) === 0;
        lc1 += out.bits[i] * e2;
        e2 = e2+e2;
    }
    lc1 === in;
    
    if (n >= maxbits()) {
       component aliasCheck = AliasCheck();
       aliasCheck.in <== out.bits;
    }
}

// ---- circuits/bitify.circom

function maxbits(){
    var n = 1;
    var r = 1;
    while(2 * n > n){
        n = n * 2;
        r = r + 1;
    }
    return r + 1;
}

function nbits(a) {
    if (a == 0){
       return 1;
    } else if (a < 0){ // in case a > p \ 2 -> we need maxbits()
       return(maxbits()); 
    } else{
        var n = 1;
        var r = 0;
    
        while (n-1<a && n >= 0) {
            r++;
            n *= 2;
        }
        if (n-1 < 0){
            return maxbits();
        }
        return r;
    }
}

// ---- circuits/buses.circom

bus BinaryNumber(n){
    signal {binary} bits[n];
}

// ---- circuits/comparators.circom

template CompConstant(n,ct) {
    assert(nbits(ct) <= n);
    input signal {binary} in[n];
    output signal {binary} out;

    signal {binary} res[n];
    if (ct & 1 == 0) {
        res[0] <== in[0];
    } else {
        res[0] <== 0;
    }
    for (var i=1; i < n; i++) {
        // re[i-1] says if in[0..i-1] > ct[0..i-1] (upto bit i-1)
        if ((ct >> i) & 1 == 0) {
            res[i] <== OR()(res[i-1],in[i]);
        } else {
            res[i] <== AND()(res[i-1],in[i]);
	}
    }
    out <== res[n-1];
}

// ---- circuits/gates.circom

template AND() {
    input signal {binary} a;
    input signal {binary} b;
    output signal {binary} out;

    out <== a*b;
}

template OR() {
    input signal {binary} a;
    input signal {binary} b;
    output signal {binary} out;

    out <== a + b - a*b;
}

// ===== END circomlib =====

component main = Top();
