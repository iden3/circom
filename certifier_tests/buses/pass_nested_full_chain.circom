pragma circom 2.2.0;

// (Nested buses) PASS, the three honest ways to establish a nested tag:
//   - HonestNested:      through a subcomponent's nested bus output
//                        (`out.inner <== m.out;`)
//   - DirectFieldWrite:  straight into the nested field (`out.inner.x <== a;`)
//   - LocalBusToBusCopy: a local whole-bus copy (`dst <== src;`) that
//                        propagates src's proven sub-tree into dst.
// @expect PASS
// @certified 5
// @trusted IsZero()
// @circomlib IsZero

bus Inner {
    signal {binary} x;
}

bus Outer {
    Inner inner;
}

template MakesInner() {
    signal input {binary} a;
    output Inner() out;
    out.x <== a;
}

template HonestNested() {
    signal input {binary} a;
    output Outer() out;
    component m = MakesInner();
    m.a <== a;
    out.inner <== m.out;
}

template DirectFieldWrite() {
    signal input {binary} a;
    output Outer() out;
    out.inner.x <== a;
}

template LocalBusToBusCopy() {
    signal input {binary} a;
    Outer() src;
    src.inner.x <== a;
    output Outer() dst;
    dst <== src;
}

template Top() {
    signal input a;
    signal output ok1;
    signal output ok2;
    signal output ok3;

    component z = IsZero();
    z.in <== a;

    component h = HonestNested();
    h.a <== z.out;
    ok1 <== h.out.inner.x;

    component d = DirectFieldWrite();
    d.a <== z.out;
    ok2 <== d.out.inner.x;

    component l = LocalBusToBusCopy();
    l.a <== z.out;
    ok3 <== l.dst.inner.x;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ===== END circomlib =====

component main = Top();
