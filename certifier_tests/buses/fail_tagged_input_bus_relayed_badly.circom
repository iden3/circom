pragma circom 2.2.0;

// (Buses) FAIL: Relay receives a {babyedwards} input bus (an axiom) but
// rebuilds its {babyedwards} output field by field from expressions: the
// input's tag does not flow through field arithmetic. CE02 on `o`.
// @expect FAIL
// @certified 1
// @trusted BabyCheck()
// @fail Relay(null) CE02
// @circomlib BabyCheck

template Relay() {
    input Point() {babyedwards} p;
    output Point() {babyedwards} o;
    o.x <== p.x * 1;
    o.y <== p.y;
}

template Top() {
    input Point() p;
    output Point() r;
    component bc = BabyCheck();
    bc.pin <== p;
    component rl = Relay();
    rl.p <== bc.pout;
    r.x <== rl.o.x;
    r.y <== rl.o.y;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/babyjub.circom

template BabyCheck() {
    input Point pin;
    output Point {babyedwards} pout;

    // Point p2;
    signal x2;
    signal y2;

    var a = 168700;
    var d = 168696;

    x2 <== pin.x*pin.x; //x2 = pin.x^2
    y2 <== pin.y*pin.y; //y2 = pin.y^2
    
    a*x2 + y2 === 1 + d*x2*y2;
    
    pout <== pin; 
}

// ---- circuits/buses.circom

bus Point(){
    signal x;
    signal y;
}

// ===== END circomlib =====

component main = Top();
