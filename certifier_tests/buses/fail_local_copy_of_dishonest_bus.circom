pragma circom 2.2.0;

// (Nested buses) FAIL: a local whole-bus copy only propagates what is
// already PROVEN in the source. `src.inner.x` is bare: reported once, at
// the root cause. `dst.inner.x` inherits nothing proven but is not reported
// separately (the template is rejected anyway).
// @expect FAIL
// @certified 0
// @fail Top() CE02

bus Inner {
    signal {binary} x;
}

bus Outer {
    Inner inner;
}

template Top() {
    signal input a;
    Outer() src;
    src.inner.x <== a * a;
    output Outer() dst;
    dst <== src;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/comparators.circom

template IsZero() {
    input signal in;
    output signal {binary} out;

    signal inv;

    inv <-- in!=0 ? 1/in : 0;

    out <== -in*inv +1;
    in*out === 0;
}

// ===== END circomlib =====

component main = Top();
