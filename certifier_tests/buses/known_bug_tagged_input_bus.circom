pragma circom 2.2.0;

// (Buses) Should PASS, currently FAILS: minimal reproduction of the
// bus-level tag bug. Use declares an INPUT bus with a bus-level tag and
// never writes it; input tags are axioms (exactly as for the scalar
// `signal input {binary} in`), yet -cbc reports CE02 on `p`. The same
// happens with the `input Point {babyedwards} p` and
// `Point() input {babyedwards} p` syntaxes.
// @expect PASS
// @certified 2
// @trusted BabyCheck()
// @known-bug a bus with a bus-level tag is never an honest source (not even as an input) -> spurious CE02
// @circomlib BabyCheck

template Use() {
    input Point() {babyedwards} p;
    signal output o;
    o <== p.x;
}

template Top() {
    input Point() p;
    signal output o;
    component bc = BabyCheck();
    bc.pin <== p;
    component u = Use();
    u.p <== bc.pout;
    o <== u.o;
}

// ===== BEGIN circomlib (generated by tools/inline_circomlib.py) =====
// Verbatim from iden3/circomlib, branch circomlib_buses, commit aef239c
// (the snapshot embedded in -cbc). Do not edit by hand: -cbc trusts these
// templates by the hash of their definition text.

// ---- circuits/babyjub.circom

template BabyCheck() {
    input Point pin;
    output Point {babyedwards} pout;

    // Point p2;
    signal x2;
    signal y2;

    var a = 168700;
    var d = 168696;

    x2 <== pin.x*pin.x; //x2 = pin.x^2
    y2 <== pin.y*pin.y; //y2 = pin.y^2
    
    a*x2 + y2 === 1 + d*x2*y2;
    
    pout <== pin; 
}

// ---- circuits/buses.circom

bus Point(){
    signal x;
    signal y;
}

// ===== END circomlib =====

component main = Top();
